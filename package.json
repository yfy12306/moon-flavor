{
  "name": "moon-flavor",
  "version": "1.5.0",
  "description": "A moonlight-flavored Pi-style theme for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
