      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "theme",
    "pi",
    "moon",
    "flavor"
  ],
  "files": [
    "README.md",
    "lib",
    "cordis.patch.yml"
  ]
}
